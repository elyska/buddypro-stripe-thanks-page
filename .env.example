# Stripe secret key — used to retrieve checkout sessions, invoices, payment intents.
# Use your own key (sk_test_… or sk_live_…). NEVER commit the real value.
NITRO_STRIPE_SECRET_KEY=sk_test_replace_me

# Telegram bot username (no leading @). Used to build activation link https://t.me/{BOT_USERNAME}?start=STRIPE_…
NITRO_BOT_USERNAME=your_bot_username

# Optional: welcome video shown under the activation link.
# Supports YouTube (watch / youtu.be / shorts), Vimeo, and direct video file URLs (.mp4, .webm).
# Leave unset to hide the embed entirely.
# NITRO_WELCOME_VIDEO_URL=https://www.youtube.com/watch?v=dQw4w9WgXcQ
